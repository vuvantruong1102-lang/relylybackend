# ===== Facebook App credentials (chung cho tất cả page) =====
FB_APP_ID=your_app_id_here
FB_APP_SECRET=your_app_secret_here
FB_GRAPH_VERSION=v21.0

# ===== Encryption key cho page access token =====
# Generate bằng: openssl rand -hex 32
# QUAN TRỌNG: Đổi key này sẽ làm mất tất cả token đã encrypt trong DB!
ENCRYPTION_KEY=replace_with_64_hex_chars

# ===== Database (Railway tự gen khi add Postgres plugin) =====
DATABASE_URL=postgresql://user:pass@host:port/db

# ===== Dashboard auth =====
# Mật khẩu chung để login vào dashboard quản lý
DASHBOARD_PASSWORD=change_me_to_strong_password

# ===== Anthropic (optional - chỉ cần nếu dùng AI reply) =====
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ===== Behavior =====
AUTO_REPLY_ENABLED=true
AUTO_SEND_SHOPEE_LINK=true
CONFIDENCE_THRESHOLD=0.7

# ===== Frontend =====
# CORS allowed origin. Có thể là 1 URL hoặc nhiều URL cách nhau bằng dấu phẩy
FRONTEND_URL=https://messenger-frontend-eight-rho.vercel.app

# ===== Server =====
PORT=3000
NODE_ENV=production

# ===== LEGACY (chỉ giữ tạm trong giai đoạn migration) =====
# Sau khi chạy `npm run import-from-env` thành công và confirm app chạy OK,
# có thể xóa các biến dưới đây:
# FB_PAGE_ID=
# FB_PAGE_ACCESS_TOKEN=
# FB_VERIFY_TOKEN=
# LEGACY_PAGE_NAME=Yokool B2B
