# --- Server -------------------------------------------------------------
PORT=3000
NODE_ENV=development

# CORS: URL của frontend Vercel (để chỉ cho phép domain này gọi API)
# Nhiều domain phân cách bằng dấu phẩy. Để trống = cho phép mọi origin.
FRONTEND_URL=https://your-app.vercel.app

# --- Facebook -----------------------------------------------------------
# From your Facebook App dashboard (https://developers.facebook.com/apps)
FB_APP_SECRET=your_app_secret_here

# Token you set when subscribing your webhook to the Page
# (you create this string yourself; FB calls it back on verification)
FB_VERIFY_TOKEN=pick_a_random_string_here

# Page Access Token — generate from Graph API Explorer or Meta Business Suite
# Required scopes: pages_messaging, pages_manage_engagement, pages_read_engagement,
# pages_manage_metadata, pages_read_user_content
FB_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxx

# Your Facebook Page ID (numeric, find at facebook.com/yourpage/about)
FB_PAGE_ID=1234567890

# Graph API version
FB_GRAPH_VERSION=v21.0

# --- Claude (Anthropic) -------------------------------------------------
# Get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Database -----------------------------------------------------------
DB_PATH=./data/replyly.db

# --- Behavior toggles ---------------------------------------------------
# When AI confidence is below this, mark for human review instead of auto-sending
CONFIDENCE_THRESHOLD=0.7

# When true, app auto-sends replies. When false, replies stay as drafts.
AUTO_REPLY_ENABLED=true

# When true, AI may include Shopee links on detected buy intent
AUTO_SEND_SHOPEE_LINK=true

# Default Shopee link when no post context is available
DEFAULT_SHOPEE_LINK=https://shopee.vn/yourshop
